{
  "_comment": "Pick ONE entry, rename it to \"regclaw\", and merge into mcpServers of claude_desktop_config.json. All paths must be ABSOLUTE. Fully quit and restart Claude Desktop after editing.",
  "mcpServers": {
    "regclaw-venv-macos": {
      "command": "/Users/<you>/regclaw/.venv/bin/python",
      "args": ["/Users/<you>/regclaw/regclaw_mcp/server.py"],
      "env": { "REGCLAW_STUB": "1" }
    },
    "regclaw-venv-windows": {
      "command": "C:\\Users\\<you>\\regclaw\\.venv\\Scripts\\python.exe",
      "args": ["C:\\Users\\<you>\\regclaw\\regclaw_mcp\\server.py"],
      "env": { "REGCLAW_STUB": "1" }
    },
    "regclaw-uv-macos": {
      "command": "/Users/<you>/.local/bin/uv",
      "args": ["run", "--project", "/Users/<you>/regclaw", "python", "/Users/<you>/regclaw/regclaw_mcp/server.py"],
      "env": { "REGCLAW_STUB": "0" }
    }
  }
}
