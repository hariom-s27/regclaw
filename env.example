# copy to .env and fill in keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# local dev only — change it
NEO4J_PASSWORD=regclaw123

# Windows: use host 127.0.0.1, not localhost (localhost tries IPv6 first: ~130 s connect delay)
PG_DSN=postgresql://regclaw:regclaw123@127.0.0.1:5432/regclaw

# Langfuse (free cloud account or self-host)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# v4 SDK name (R8). LANGFUSE_HOST is deprecated but still accepted via lf_common.py.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional, Azure role S10 only (see eval/s10/README.md). Leave unset to keep the default behaviour.
# Output cap in tokens (integer 1..128000), the same at every effort. Pre-registered value for the S10 evaluation: 64000.
# AZURE_OPENAI_S10_MAX_COMPLETION_TOKENS=
# Client timeout in seconds (number > 0).
# AZURE_OPENAI_S10_TIMEOUT_S=
